{
  "name": "nsu-planner-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for NSU Course Planning and Advising",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "bundle:plugin": "zip -r nsu-advising-planner.zip .claude-plugin skills .mcp.json",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.3",
    "@vercel/node": "^31.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
